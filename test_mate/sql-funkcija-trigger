-- Skalarna funkcija
CREATE FUNCTION dbo.AddNumbers (@num1 INT, @num2 INT)
RETURNS INT
AS
BEGIN
    RETURN @num1 + @num2;
END;

CREATE FUNCTION dbo.GetEmployeesByDept (@deptId INT)
RETURNS TABLE
AS
RETURN (
    SELECT emp_name, emp_id 
    FROM Employees 
    WHERE dept_id = @deptId
);

